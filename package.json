{
  "name": "@piesp/browser-core",
  "version": "0.1.0",
  "description": "Shared TypeScript utilities for PiesP browser-based projects",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiesP/browser-core.git"
  },
  "bugs": {
    "url": "https://github.com/PiesP/browser-core/issues"
  },
  "homepage": "https://github.com/PiesP/browser-core#readme",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./async": "./src/async/index.ts",
    "./design": "./src/design/index.ts",
    "./design/tokens.css": "./src/design/generated/tokens.css",
    "./design/tokens.json": "./src/design/quiet-instruments.tokens.json",
    "./error": "./src/error/index.ts",
    "./events": "./src/events/index.ts",
    "./locale": "./src/locale/index.ts",
    "./logging": "./src/logging/index.ts",
    "./util": "./src/util/index.ts"
  },
  "scripts": {
    "check": "pnpm check:format && pnpm check:design && pnpm check:types && pnpm check:lint",
    "check:design": "node scripts/generate-design-tokens.mjs --check",
    "check:format": "node scripts/check-format.mjs",
    "check:types": "tsc --noEmit",
    "check:lint": "tsc --noEmit --allowUnreachableCode false --allowUnusedLabels false",
    "generate:design": "node scripts/generate-design-tokens.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "verify": "pnpm check && pnpm test:cov",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "26.7.0",
    "pnpm": "11.2.2"
  }
}
