{
  "name": "@piesp/browser-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript utilities for PiesP browser-based projects",
  "homepage": "https://github.com/PiesP/browser-core#readme",
  "bugs": {
    "url": "https://github.com/PiesP/browser-core/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiesP/browser-core.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./async": "./src/async/index.ts",
    "./design": "./src/design/index.ts",
    "./design/tokens.css": "./src/design/generated/tokens.css",
    "./design/tokens.json": "./src/design/quiet-instruments.tokens.json",
    "./error": "./src/error/index.ts",
    "./events": "./src/events/index.ts",
    "./locale": "./src/locale/index.ts",
    "./logging": "./src/logging/index.ts",
    "./util": "./src/util/index.ts"
  },
  "scripts": {
    "check": "vp check && pnpm check:design && pnpm check:types",
    "check:design": "node scripts/generate-design-tokens.ts --check",
    "check:format": "vp fmt --check",
    "check:types": "tsc --noEmit --project tsconfig.json && tsc --project tsconfig.scripts.json",
    "generate:design": "node scripts/generate-design-tokens.ts",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "verify": "pnpm check && pnpm test:cov",
    "test:watch": "vp test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "pnpm": ">=12.14.0"
  },
  "volta": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
